# ML model API base URL (the FastAPI service in code-api/)
ML_API_URL=http://localhost:8000

# HTTP timeout in seconds for ML API calls
ML_API_TIMEOUT=10.0

# CORS allowed origins (comma-separated, no spaces)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Server port for this estimator API
PORT=8001
